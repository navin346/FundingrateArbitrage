# ============ Setu bot configuration (copy to .env, never commit .env) ============

# ---- mode: start in paper. Only flip to live after 1-2 weeks of paper track record.
MODE=paper
# To go live you must ALSO set the exact phrase below (safety interlock):
# MODE=live
# LIVE_CONFIRM=I_UNDERSTAND_LIVE_TRADING_RISKS

# ---- sizing (per delta-neutral pair: 2 legs, each margin x leverage notional)
MARGIN_PER_LEG_USD=200
LEVERAGE=3

# ---- entry filters
MIN_ENTRY_GROSS_APR=100        # only enter spreads paying >=100% annualized
MIN_PAIR_LIQ_USD=1000000       # both legs must have >=$1M OI/volume
MAX_PX_DIVERGENCE_ENTRY_PCT=1.0
MAX_BREAKEVEN_DAYS=4           # costs must be earned back within 4 days
ENTRY_COOLDOWN_HOURS=6
SYMBOL_BLACKLIST=              # comma separated, e.g. TRUMP,FARTCOIN

# ---- exit rules
EXIT_GROSS_APR=20              # close when spread decays below 20% APR (2 ticks)
MAX_HOLD_DAYS=10
MAX_PX_DIVERGENCE_EXIT_PCT=3.0

# ---- circuit breakers
MAX_OPEN_PAIRS=3
MAX_TOTAL_NOTIONAL_USD=5000
PAIR_STOP_LOSS_USD=100         # close a pair losing more than this
DAILY_LOSS_LIMIT_USD=200       # halt new entries 24h after this much realized loss
LOOP_MINUTES=5

# ---- notifications (optional but recommended: bot pings you on every action)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- live credentials (leave empty in paper mode)
# Hyperliquid: create an API/agent wallet at https://app.hyperliquid.xyz/API
# (agent keys can trade but CANNOT withdraw). Put the AGENT private key here
# and your main account address below.
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=
# Aster: create an API key with TRADE-ONLY permission + IP whitelist.
ASTER_API_KEY=
ASTER_API_SECRET=
